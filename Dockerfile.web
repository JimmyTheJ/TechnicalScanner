FROM node:22-alpine AS build
WORKDIR /app
COPY src/TechnicalScanner.Web/package.json src/TechnicalScanner.Web/package-lock.json ./
RUN npm ci
COPY src/TechnicalScanner.Web/ ./
RUN npm run build

FROM nginx:alpine
COPY src/TechnicalScanner.Web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
