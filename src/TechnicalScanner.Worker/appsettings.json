{
  "ConnectionStrings": {
    "TechnicalScanner": "Host=localhost;Port=5432;Database=technical_scanner;Username=postgres;Password=postgres"
  },
  "MarketData": {
    "Provider": "YahooFinance",
    "RequestsPerSecond": 2,
    "MaxRetries": 3,
    "RetryDelaySeconds": 2,
    "InitialHistoryYears": 10,
    "Universe": {
      "IncludeUs": true,
      "IncludeCanada": true,
      "IncludeEtfs": true
    }
  },
  "Alerts": {
    "Enabled": false,
    "MinMinutesBetweenDuplicates": 60,
    "NotifyOnSignalFired": true,
    "NotifyOnSignalCleared": false,
    "CompositeScoreThreshold": 4,
    "CompositeScoreCode": "DEEP_PULLBACK",
    "SignalCodes": [
      "BMSB_ABOVE",
      "BMSB_BELOW",
      "PRICE_BELOW_200D_SMA",
      "PRICE_ABOVE_200D_SMA",
      "RSI_D_OVERSOLD",
      "RSI_W_ABOVE_50",
      "BB_D_BELOW_LOWER"
    ],
    "BreadthRules": [
      {
        "MetricCode": "BMSB_W_ABOVE_PCT",
        "Threshold": 20,
        "Direction": "CrossBelow"
      },
      {
        "MetricCode": "BMSB_W_ABOVE_PCT",
        "Threshold": 50,
        "Direction": "CrossAbove"
      },
      {
        "MetricCode": "PROFILE_DEEP_PULLBACK_PCT",
        "Threshold": 20,
        "Direction": "CrossAbove"
      }
    ],
    "Channels": {
      "Webhook": { "Enabled": false, "Url": "" },
      "Email": {
        "Enabled": false,
        "SmtpHost": "",
        "SmtpPort": 587,
        "UseSsl": true,
        "Username": "",
        "Password": "",
        "FromAddress": "",
        "ToAddress": ""
      },
      "Telegram": { "Enabled": false, "BotToken": "", "ChatId": "" },
      "Discord": { "Enabled": false, "WebhookUrl": "" },
      "Slack": { "Enabled": false, "WebhookUrl": "" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
