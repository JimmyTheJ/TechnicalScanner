{
  "ConnectionStrings": {
    "TechnicalScanner": "Host=localhost;Port=5432;Database=technical_scanner;Username=postgres;Password=postgres"
  },
  "MarketData": {
    "Provider": "YahooFinance",
    "RequestsPerSecond": 2,
    "MaxRetries": 3,
    "RetryDelaySeconds": 2,
    "InitialHistoryYears": 10,
    "Universe": {
      "IncludeUs": true,
      "IncludeCanada": true,
      "IncludeEtfs": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
