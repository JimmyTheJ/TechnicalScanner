# Host ports when using compose.ps1 / compose.sh (override if they clash)
WEB_PORT=3080
API_PORT=5223
POSTGRES_PORT=5432

POSTGRES_DB=technical_scanner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host directory bind-mounted to Postgres data. Relative paths are from the compose file.
# Example on a Linux server: POSTGRES_DATA_PATH=/mnt/d/technical-scanner/postgres
POSTGRES_DATA_PATH=./data/postgres

# Nested appsettings.json keys use __ (colon in ASP.NET configuration).
# Host-run apps (dotnet run) use this connection string. Compose overrides Host=technical-scanner-postgres inside api/worker.
ConnectionStrings__TechnicalScanner=Host=localhost;Port=5432;Database=technical_scanner;Username=postgres;Password=postgres

MarketData__Provider=YahooFinance
MarketData__RequestsPerSecond=2
MarketData__MaxRetries=3
MarketData__RetryDelaySeconds=2
MarketData__TooManyRequestsDelayMinutes=30
MarketData__TooManyRequestsAdditionalMinutes=30
MarketData__TooManyRequestsMultiplier=1
MarketData__InitialHistoryYears=10
MarketData__Universe__IncludeUs=true
MarketData__Universe__IncludeCanada=true
MarketData__Universe__IncludeEtfs=true

Alerts__Enabled=false
Alerts__MinMinutesBetweenDuplicates=60
Alerts__NotifyOnSignalFired=true
Alerts__NotifyOnSignalCleared=false
Alerts__NotifyOnProfileEntered=true
Alerts__NotifyOnProfileExited=false
Alerts__CompositeScoreThreshold=4
Alerts__CompositeScoreCode=DEEP_PULLBACK
Alerts__Channels__Webhook__Enabled=false
Alerts__Channels__Webhook__Url=
Alerts__Channels__Email__Enabled=false
Alerts__Channels__Email__SmtpHost=smtp.purelymail.com
Alerts__Channels__Email__SmtpPort=587
Alerts__Channels__Email__UseSsl=true
Alerts__Channels__Email__Username=
Alerts__Channels__Email__Password=
Alerts__Channels__Email__FromAddress=
Alerts__Channels__Email__ToAddress=
Alerts__Channels__Telegram__Enabled=false
Alerts__Channels__Telegram__BotToken=
Alerts__Channels__Telegram__ChatId=
Alerts__Channels__Discord__Enabled=false
Alerts__Channels__Discord__WebhookUrl=
Alerts__Channels__Slack__Enabled=false
Alerts__Channels__Slack__WebhookUrl=

# Optional: attach services to an existing Docker network (e.g. nginx reverse proxy).
# On that network, services resolve by container_name (use the container port, not the host port).
# Use compose.ps1 / compose.sh (not bare docker compose) so this value is picked up.
# The network must already exist on the host.
# DOCKER_SHARED_NETWORK=nginx_network
